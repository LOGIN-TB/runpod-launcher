{
  "name": "runpod-launcher",
  "private": true,
  "version": "0.1.0",
  "description": "Launcher for RunPod GPU pods serving OpenAI-compatible LLM and embedding endpoints",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "dev:service": "npm run dev -w @runpod-launcher/service",
    "gen:runpod": "node tools/generate-runpod-types.mjs",
    "test": "npm run test --workspaces --if-present",
    "screenshots": "node tools/screenshots/capture.mjs",
    "service": "node apps/service/dist/index.js"
  },
  "devDependencies": {
    "wait-on": "^9.1.0"
  }
}
